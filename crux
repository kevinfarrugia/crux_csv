#!/bin/bash

usage() {
  echo -e "Usage: $0 [options...] <url> <key> \n\
       $0 [options...] -i <path> <key> \n\
 -h, --help          Display help
 -o, --output <path> Output path where to save results \n\
 -a, --append        Append results to output file \n\
 -O, --origin        Collect data for origin-level \n\
 -c, --crawl         Discover URLs for the domain (via sitemap.xml, falling back \n\
                     to crawling links) and query CrUX for each, up to $max_urls URLs \n\
 -i, --input <path>  Read newline-separated URLs from a file and query CrUX for each \n\
 -f, --full          Include histogram data (grouped as Good, NI and Poor) \n\
 -F, --format        Output format (csv, md) \n\
 -V, --verbose       Make the operation more talkative" 1>&2
  exit 1
}

output=
input=
verbose=0
append=0
full=0
origin=0
crawl=0
format="csv"
positional=()
crawl_max_depth=2
max_urls=1000
max_queries_per_minute=150
query_timestamps=()

while [[ $# -gt 0 ]]; do
  case $1 in
  -h | --help)
    usage
    ;;
  -V | --verbose)
    verbose=1
    shift
    ;;
  -a | --append)
    append=1
    shift
    ;;
  -O | --origin)
    origin=1
    shift
    ;;
  -c | --crawl)
    crawl=1
    shift
    ;;
  -i | --input)
    if [ -z "$2" ]; then
      echo "Missing value for $1" 1>&2
      usage
    fi
    input=$2
    shift 2
    ;;
  -F | --format)
    if [ -z "$2" ]; then
      echo "Missing value for $1" 1>&2
      usage
    fi
    format=$2
    shift 2
    ;;
  -f | --full)
    full=1
    shift
    ;;
  -o | --output)
    if [ -z "$2" ]; then
      echo "Missing value for $1" 1>&2
      usage
    fi
    output=$2
    shift 2
    ;;
  --)
    shift
    positional+=("$@")
    break
    ;;
  -*)
    echo "Unknown option: $1" 1>&2
    usage
    ;;
  *)
    positional+=("$1")
    shift
    ;;
  esac
done

if [ -n "$input" ]; then
  key=${positional[0]}
else
  url=${positional[0]}
  key=${positional[1]}
fi

if [ "$format" != "csv" ] && [ "$format" != "md" ]; then
  echo "Invalid format: $format (expected csv or md)" 1>&2
  usage
fi

if [ -z "$input" ] && [ -z "$url" ]; then
  usage
fi

if [ -z "$key" ]; then
  echo "CrUX API key is missing or invalid."
  exit 1
fi

if [ "$crawl" == 1 ] && [ "$origin" == 1 ]; then
  echo "--crawl cannot be combined with --origin" 1>&2
  usage
fi

if [ -n "$input" ] && [ "$crawl" == 1 ]; then
  echo "--input cannot be combined with --crawl" 1>&2
  usage
fi

if [ "$crawl" == 1 ] && [[ ! "$url" =~ ^https?://[^/]+ ]]; then
  echo "--crawl requires <url> to include a scheme and host, e.g. https://example.com" 1>&2
  exit 1
fi

if [ -n "$input" ] && [ ! -r "$input" ]; then
  echo "Input file not found or not readable: $input" 1>&2
  exit 1
fi

if [ "$verbose" == 1 ]; then
  if [ -n "$input" ]; then
    echo -e "Running CrUX on URLs from $input"
  else
    echo -e "Running CrUX on $url"
  fi
  echo -e "...\n"
fi

if [ "$append" == 0 ] && [ -f "$output" ]; then
  read -p "Output file exists. Overwrite? (y/N) " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Nn]$ ]] || [[ -z $REPLY ]]; then
    exit
  fi
fi

write_header=0
if [ -n "$output" ] && { [ "$append" == 0 ] || [ ! -f "$output" ]; }; then
  write_header=1
fi

if [ "$write_header" == 1 ]; then
  if [ "$verbose" == 1 ]; then
    if [ "$append" == 0 ]; then
      echo "Overwriting contents in $output"
    else
      echo "Creating new output file $output"
    fi
    echo
  fi
  if [ "$full" == 1 ]; then
    if [ "$format" == "md" ]; then
      {
        echo "Date|URL|Form|LCP|LCP (good)|LCP (NI)|LCP (poor)|CLS|CLS (good)|CLS (NI)|CLS (poor)|FCP|FCP (good)|FCP (NI)|FCP (poor)|INP|INP (good)|INP (NI)|INP (poor)|TTFB|TTFB (good)|TTFB (NI)|TTFB (poor)|RTT"
        echo "-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-"
      } >"$output"
    else
      echo "Date,URL,Form,LCP,LCP (good),LCP (NI),LCP (poor),CLS,CLS (good),CLS (NI),CLS (poor),FCP,FCP (good),FCP (NI),FCP (poor),INP,INP (good),INP (NI),INP (poor),TTFB,TTFB (good),TTFB (NI),TTFB (poor),RTT" >"$output"
    fi
  else
    if [ "$format" == "md" ]; then
      {
        echo "Date|URL|Form|LCP|CLS|FCP|INP|TTFB|RTT"
        echo "-|-|-|-|-|-|-|-|-"
      } >"$output"
    else
      echo "Date,URL,Form,LCP,CLS,FCP,INP,TTFB,RTT" >"$output"
    fi
  fi
elif [ -z "$output" ]; then
  if [ "$full" == 1 ]; then
    if [ "$format" == "md" ]; then
      echo "Date|URL|Form|LCP|LCP (good)|LCP (NI)|LCP (poor)|CLS|CLS (good)|CLS (NI)|CLS (poor)|FCP|FCP (good)|FCP (NI)|FCP (poor)|INP|INP (good)|INP (NI)|INP (poor)|TTFB|TTFB (good)|TTFB (NI)|TTFB (poor)|RTT"
      echo "-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-|-"
    else
      echo "Date,URL,Form,LCP,LCP (good),LCP (NI),LCP (poor),CLS,CLS (good),CLS (NI),CLS (poor),FCP,FCP (good),FCP (NI),FCP (poor),INP,INP (good),INP (NI),INP (poor),TTFB,TTFB (good),TTFB (NI),TTFB (poor),RTT"
    fi
  else
    if [ "$format" == "md" ]; then
      echo "Date|URL|Form|LCP|CLS|FCP|INP|TTFB|RTT"
      echo "-|-|-|-|-|-|-|-|-"
    else
      echo "Date,URL,Form,LCP,CLS,FCP,INP,TTFB,RTT"
    fi
  fi
fi

if [ "$full" == 1 ]; then
  query='[(now | strftime("%Y/%m/%d")), .record.key.url + .record.key.origin, .record.key.formFactor, .record.metrics.largest_contentful_paint.percentiles.p75, .record.metrics.largest_contentful_paint.histogram[0].density, .record.metrics.largest_contentful_paint.histogram[1].density, .record.metrics.largest_contentful_paint.histogram[2].density, .record.metrics.cumulative_layout_shift.percentiles.p75, .record.metrics.cumulative_layout_shift.histogram[0].density, .record.metrics.cumulative_layout_shift.histogram[1].density, .record.metrics.cumulative_layout_shift.histogram[2].density, .record.metrics.first_contentful_paint.percentiles.p75, .record.metrics.first_contentful_paint.histogram[0].density, .record.metrics.first_contentful_paint.histogram[1].density, .record.metrics.first_contentful_paint.histogram[2].density, .record.metrics.interaction_to_next_paint.percentiles.p75, .record.metrics.interaction_to_next_paint.histogram[0].density, .record.metrics.interaction_to_next_paint.histogram[1].density, .record.metrics.interaction_to_next_paint.histogram[2].density, .record.metrics.experimental_time_to_first_byte.percentiles.p75, .record.metrics.experimental_time_to_first_byte.histogram[0].density, .record.metrics.experimental_time_to_first_byte.histogram[1].density, .record.metrics.experimental_time_to_first_byte.histogram[2].density,  .record.metrics.round_trip_time.percentiles.p75]'
else
  query='[(now | strftime("%Y/%m/%d")), .record.key.url + .record.key.origin, .record.key.formFactor, .record.metrics.largest_contentful_paint.percentiles.p75, .record.metrics.cumulative_layout_shift.percentiles.p75, .record.metrics.first_contentful_paint.percentiles.p75, .record.metrics.interaction_to_next_paint.percentiles.p75, .record.metrics.experimental_time_to_first_byte.percentiles.p75, .record.metrics.round_trip_time.percentiles.p75]'
fi

discovered_urls=()
sitemap_seen=()

# Only accept same-host http(s) URLs, deduped, up to $max_urls total.
add_discovered_url() {
  local candidate=$1

  if [ "${#discovered_urls[@]}" -ge "$max_urls" ]; then
    return
  fi

  if [[ ! "$candidate" =~ ^https?://([^/]+) ]]; then
    return
  fi
  if [ "${BASH_REMATCH[1]}" != "$host" ]; then
    return
  fi

  local existing
  for existing in "${discovered_urls[@]}"; do
    if [ "$existing" == "$candidate" ]; then
      return
    fi
  done

  discovered_urls+=("$candidate")
}

# Fetches a sitemap (or sitemap index, recursively) and adds any <loc> entries found.
fetch_sitemap_urls() {
  local sitemap_url=$1
  local seen

  for seen in "${sitemap_seen[@]}"; do
    if [ "$seen" == "$sitemap_url" ]; then
      return
    fi
  done
  sitemap_seen+=("$sitemap_url")

  if [ "${#discovered_urls[@]}" -ge "$max_urls" ]; then
    return
  fi

  local xml
  xml=$(curl -sL --max-time 10 "$sitemap_url" 2>/dev/null)
  if [ -z "$xml" ]; then
    return
  fi

  local locs
  locs=$(grep -Eo '<loc>[^<]*</loc>' <<<"$xml" | sed -E 's/<\/?loc>//g')
  if [ -z "$locs" ]; then
    return
  fi

  if grep -q "<sitemapindex" <<<"$xml"; then
    local sub
    while IFS= read -r sub; do
      if [ "${#discovered_urls[@]}" -ge "$max_urls" ]; then
        break
      fi
      fetch_sitemap_urls "$sub"
    done <<<"$locs"
  else
    local u
    while IFS= read -r u; do
      add_discovered_url "$u"
    done <<<"$locs"
  fi
}

# Resolves an href found on $base into an absolute URL, or prints nothing if
# it should be ignored (fragment-only, mailto:, javascript:, etc).
resolve_url() {
  local base=$1 link=$2

  case "$link" in
  "#"* | mailto:* | javascript:* | tel:* | data:* | "")
    return
    ;;
  esac

  link=${link%%#*}
  if [ -z "$link" ]; then
    return
  fi

  if [[ "$link" =~ ^https?:// ]]; then
    echo "$link"
  elif [[ "$link" =~ ^// ]]; then
    echo "https:$link"
  elif [[ "$link" =~ ^/ ]]; then
    echo "${origin_url}${link}"
  else
    echo "${base%/*}/${link}"
  fi
}

# Breadth-first crawl of same-host links starting at the homepage, up to
# $crawl_max_depth levels deep and $max_urls distinct URLs.
crawl_links() {
  add_discovered_url "$origin_url/"

  local frontier=("$origin_url/")
  local depth
  for ((depth = 0; depth < crawl_max_depth; depth++)); do
    local next_frontier=()
    local page
    for page in "${frontier[@]}"; do
      if [ "${#discovered_urls[@]}" -ge "$max_urls" ]; then
        return
      fi

      local html
      html=$(curl -sL --max-time 10 "$page" 2>/dev/null)
      if [ -z "$html" ]; then
        continue
      fi

      local hrefs
      hrefs=$(grep -Eo 'href="[^"]*"' <<<"$html" | sed -E 's/^href="//; s/"$//')

      local href abs before after
      while IFS= read -r href; do
        if [ "${#discovered_urls[@]}" -ge "$max_urls" ]; then
          break
        fi
        abs=$(resolve_url "$page" "$href")
        if [ -z "$abs" ]; then
          continue
        fi
        before=${#discovered_urls[@]}
        add_discovered_url "$abs"
        after=${#discovered_urls[@]}
        if [ "$after" -gt "$before" ]; then
          next_frontier+=("$abs")
        fi
      done <<<"$hrefs"
    done
    frontier=("${next_frontier[@]}")
    if [ "${#frontier[@]}" -eq 0 ]; then
      break
    fi
  done
}

# Blocks until issuing another CrUX API request would keep the rolling
# per-minute rate at or below $max_queries_per_minute.
throttle_query() {
  local now
  now=$(date +%s)

  while [ "${#query_timestamps[@]}" -gt 0 ] && [ $((now - query_timestamps[0])) -ge 60 ]; do
    query_timestamps=("${query_timestamps[@]:1}")
  done

  if [ "${#query_timestamps[@]}" -ge "$max_queries_per_minute" ]; then
    local sleep_time=$((60 - (now - query_timestamps[0])))
    if [ "$sleep_time" -gt 0 ]; then
      if [ "$verbose" == 1 ]; then
        echo "Rate limit of $max_queries_per_minute queries/minute reached. Sleeping for ${sleep_time}s..."
      fi
      sleep "$sleep_time"
    fi
    now=$(date +%s)
    while [ "${#query_timestamps[@]}" -gt 0 ] && [ $((now - query_timestamps[0])) -ge 60 ]; do
      query_timestamps=("${query_timestamps[@]:1}")
    done
  fi

  query_timestamps+=("$now")
}

fetch_form_factor() {
  local form_factor=$1
  local target_url=$2
  local data raw has_record result

  if [ "$origin" == 1 ]; then
    data=$(jq -n --arg origin "$target_url" --arg formFactor "$form_factor" '{origin: $origin, formFactor: $formFactor}')
  else
    data=$(jq -n --arg url "$target_url" --arg formFactor "$form_factor" '{url: $url, formFactor: $formFactor}')
  fi

  if [ "$verbose" == 1 ]; then
    echo -e "curl \"https://chromeuxreport.googleapis.com/v1/records:queryRecord?key=$key\"\n\
  --header 'Content-Type: application/json'\n\
  --data '$data'"
    echo
  fi

  throttle_query

  raw=$(curl -s "https://chromeuxreport.googleapis.com/v1/records:queryRecord?key=$key" \
    --header 'Content-Type: application/json' \
    --data "$data")

  has_record=$(jq -r 'if .record then "1" else "0" end' <<<"$raw" 2>/dev/null)
  if [ "$has_record" != "1" ]; then
    return
  fi

  result=$(jq -r "$query | @csv" <<<"$raw")

  if [ "$format" == "md" ]; then
    result=$(echo "$result" | sed -r 's/,/|/g')
  fi

  if [ -n "$output" ]; then
    echo "$result" >>"$output"
  else
    echo "$result"
  fi
}

if [ "$crawl" == 1 ]; then
  origin_url=$(grep -Eo '^https?://[^/]+' <<<"$url")
  host=$(sed -E 's#^https?://##' <<<"$origin_url")

  fetch_sitemap_urls "${origin_url}/sitemap.xml"

  if [ "${#discovered_urls[@]}" -eq 0 ]; then
    crawl_links
  fi

  if [ "${#discovered_urls[@]}" -eq 0 ]; then
    discovered_urls=("$url")
  fi

  if [ "$verbose" == 1 ]; then
    echo "Discovered ${#discovered_urls[@]} URL(s) for $host"
    echo
  fi
elif [ -n "$input" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    if [ -z "$line" ]; then
      continue
    fi
    discovered_urls+=("$line")
  done <"$input"

  if [ "$verbose" == 1 ]; then
    echo "Read ${#discovered_urls[@]} URL(s) from $input"
    echo
  fi
else
  discovered_urls=("$url")
fi

for target_url in "${discovered_urls[@]}"; do
  fetch_form_factor "PHONE" "$target_url"
  fetch_form_factor "DESKTOP" "$target_url"
done

if [ -n "$output" ] && [ "$verbose" == 1 ]; then
  echo -e "Saved results to $output\n"
fi

if [ "$verbose" == 1 ]; then
  echo "Done."
fi
